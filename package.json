{
	"name": "@natlibfi/passport-melinda-jwt",
	"description": "Passport authentication strategy for Melinda using JWT tokens",
	"author": {
		"name": "The National Library of Finland"
	},
	"keywords": [],
	"homepage": "https://www.npmjs.com/package/@natlibfi/passport-melinda-jwt",
	"bugs": {
		"url": "https://github.com/NatLibFi/passport-melinda-jwt-js/issues"
	},
	"repository": {
		"url": "https://github.com/NatLibFi/passport-melinda-jwt-js"
	},
	"license": "MIT",
	"version": "4.0.0-alpha.2",
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "rm -rf dist && tsc",
