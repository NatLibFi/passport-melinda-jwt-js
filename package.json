		"test": "npm run lint && npm run test:base",
		"test:base": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec './src/*.test.ts'"
	},
	"dependencies": {
		"jsonwebtoken": "^9.0.3",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1"
	},
	"devDependencies": {
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.6",
		"@types/passport-jwt": "^4.0.1",
		"eslint": "^10.14.0",
		"jiti": "^2.7.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2"
	}
}
